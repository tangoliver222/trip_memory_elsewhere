# === Else AI Service 环境变量 ===
# 必填（非 Vertex 模式）：AI Studio 的 Gemini API key，只存在于服务端
GEMINI_API_KEY=

# 模型别名指向（业务代码只认别名，模型 ID 只出现在这里）
# FAST_MULTIMODAL：日常单对象回答
ELSE_MODEL_FAST=gemini-flash-latest
# DEEP_REASONING：冲突 / 规律 / 跨对象推理，生产建议指向 Pro 级模型（如 gemini-3.1-pro）
# 未配置时与 FAST 同源；配置后调用失败会自动回退 FAST
# ELSE_MODEL_DEEP=

# Vertex 模式（P1，替代 GEMINI_API_KEY）
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=elsewhere-dev
# GOOGLE_CLOUD_LOCATION=global

# 服务端口（Cloud Run 会注入 PORT）
PORT=8787

# 生产收紧为前端域名，例如 https://elsewhere.example.app
ELSE_CORS_ORIGIN=*

# 确定性处理 runtime deadlines：soft < lease <= request - cleanup margin
PROCESSING_SOFT_TIMEOUT_MS=180000
PROCESSING_LEASE_MS=240000
CLOUD_RUN_REQUEST_TIMEOUT_MS=300000
PROCESSING_CLEANUP_MARGIN_MS=30000

# 媒体处理 hard caps；部署可调低，不可超过这些 v1 上限
MAX_INPUT_BYTES=52428800
MAX_INPUT_PIXELS=60000000
MAX_IMAGE_WIDTH=20000
MAX_IMAGE_HEIGHT=20000
MAX_PAGE_COUNT=100
MAX_METADATA_DECOMPRESSED_BYTES=16777216
