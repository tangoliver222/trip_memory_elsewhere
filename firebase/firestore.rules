rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owns(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/fragments/{fragmentId} {
      allow read: if owns(userId);
      allow write: if false;
    }

    match /users/{userId}/importBatches/{batchId} {
      allow read: if owns(userId);
      allow write: if false;
    }

    match /users/{userId}/duplicateCandidates/{candidateId} {
      allow read: if owns(userId);
      allow write: if false;
    }

    match /users/{userId}/processingTasks/{taskId} {
      allow read, write: if false;
    }

    match /users/{userId}/contentHashes/{hashId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
