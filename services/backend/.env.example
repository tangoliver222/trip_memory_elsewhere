# Copy to services/backend/.env. Node 22 loads it for dev/start/smoke scripts.
# Never commit .env or service-account JSON keys.

NODE_ENV=development
HOST=127.0.0.1
PORT=8787
LOG_LEVEL=info

# Select exactly one composition root per process.
ELSEWHERE_SERVICE_MODE=api
FIREBASE_PROJECT_ID=demo-elsewhere
# Firebase App IDs, not API keys. Required in production API mode.
ELSEWHERE_ALLOWED_APP_IDS=elsewhere-web-local
# Comma-separated exact bucket names. Required by ingestion and capability-worker.
ELSEWHERE_STORAGE_BUCKETS=demo-elsewhere.appspot.com

# Local browser + real Firebase bridge for the competition recording only.
# This mode must remain development-only and rejects every Emulator host.
ELSEWHERE_CLOUD_DEMO_MODE=false
# Remains false until the owner explicitly allows sending selected original bytes to Document AI.
ELSEWHERE_DOCUMENT_AI_DEMO_ALLOWED=false

# Default is guaranteed not to construct Cloud Tasks or Document AI adapters.
CAPABILITY_EXECUTION_MODE=fake
OCR_PROVIDER_VERSION=fake-processor-v1
CLOUD_TASKS_ENABLED=false
DOCUMENT_AI_ENABLED=false
RUN_REAL_GOOGLE_PROVIDER_TESTS=false

# Ingestion google mode only:
# ELSEWHERE_SERVICE_MODE=ingestion
# CAPABILITY_EXECUTION_MODE=google
# OCR_PROVIDER_VERSION=<same fixed value as DOCUMENT_AI_PROCESSOR_VERSION>
# CLOUD_TASKS_ENABLED=true
CLOUD_TASKS_PROJECT_ID=
CLOUD_TASKS_LOCATION=
OCR_TASK_QUEUE=
OCR_WORKER_URL=
OCR_WORKER_AUDIENCE=
OCR_TASK_SERVICE_ACCOUNT=

# Capability-worker google mode only. Keep CLOUD_TASKS_ENABLED=false.
# ELSEWHERE_SERVICE_MODE=capability-worker
# CAPABILITY_EXECUTION_MODE=google
# DOCUMENT_AI_ENABLED=true
# RUN_REAL_GOOGLE_PROVIDER_TESTS=true  # only for an intentional local smoke
DOCUMENT_AI_PROJECT_ID=
DOCUMENT_AI_LOCATION=
DOCUMENT_AI_PROCESSOR_ID=
DOCUMENT_AI_PROCESSOR_VERSION=
# Example shape: us-documentai.googleapis.com (must match the chosen region).
DOCUMENT_AI_ENDPOINT=

# Production Else query is API-only and Vertex-only. It stays disabled for local defaults.
# When enabled, GOOGLE_CLOUD_PROJECT must equal FIREBASE_PROJECT_ID and GEMINI_API_KEY must be empty.
ELSE_QUERY_ENABLED=false
ELSE_QUERY_OWNER_DAILY_LIMIT=10
ELSE_QUERY_PROJECT_DAILY_LIMIT=100
GEMINI_API_KEY=
ELSE_MODEL_FAST=gemini-2.5-flash
# ELSE_MODEL_DEEP=
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
ELSE_CORS_ORIGIN=*

# Deterministic processing deadlines: soft < lease <= request - cleanup margin.
PROCESSING_SOFT_TIMEOUT_MS=180000
PROCESSING_LEASE_MS=240000
CLOUD_RUN_REQUEST_TIMEOUT_MS=300000
PROCESSING_CLEANUP_MARGIN_MS=30000

# Hard caps may be lowered per deployment, never raised above v1 maxima.
MAX_INPUT_BYTES=52428800
MAX_INPUT_PIXELS=60000000
MAX_IMAGE_WIDTH=20000
MAX_IMAGE_HEIGHT=20000
MAX_PAGE_COUNT=100
MAX_METADATA_DECOMPRESSED_BYTES=16777216
